# Gateway — OpenAI-compatible endpoint ONLY. Clients use https://aicoyy.dev/v1/...
aicoyy.dev {
	encode zstd gzip
	# LLM payloads can be large (long context / base64 images). Raise limits.
	request_body {
		max_size 100MB
	}

	# Gateway domain is not the dashboard: send UI paths away.
	@web path /dashboard /dashboard/* /login /login/*
	handle @web {
		respond "Dashboard lives at https://track.aicoyy.dev" 404
	}

	# Coming-soon landing — browsers hitting the bare root only.
	# API clients use /v1/* and fall through to the reverse_proxy below.
	@root path /
	handle @root {
		root * /var/www/aicoyy
		rewrite * /coming-soon.html
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:20128 {
			# App reads the real client IP from these (peer is loopback → trusted).
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			# Streaming (SSE): don't buffer, allow long-lived responses.
			flush_interval -1
			transport http {
				response_header_timeout 10m
			}
		}
	}
}

# Dashboard / web UI ONLY at https://track.aicoyy.dev/dashboard
track.aicoyy.dev {
	encode zstd gzip

	# Not a gateway: block the OpenAI-compatible chat surface here.
	# Keep /v1/models — the dashboard's API-key scope picker fetches it.
	@gateway {
		path /v1 /v1/* /v1beta /v1beta/*
		not path /v1/models /v1/models/*
	}
	handle @gateway {
		respond "Gateway lives at https://aicoyy.dev" 404
	}

	handle {
		reverse_proxy 127.0.0.1:20128 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}
